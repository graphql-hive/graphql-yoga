{
  "name": "@envelop/apollo-datasources",
  "version": "7.2.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/graphql-hive/graphql-yoga.git",
    "directory": "packages/envelop/plugins/apollo-datasources"
  },
  "homepage": "https://github.com/graphql-hive/graphql-yoga/tree/main/packages/envelop/plugins/apollo-datasources#readme",
  "bugs": {
    "url": "https://github.com/graphql-hive/graphql-yoga/issues"
  },
  "author": "Kamil Kisiela <kamil.kisiela@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "main": "dist/cjs/index.js",
  "typings": "dist/typings/index.d.ts",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./*": {
      "require": {
        "types": "./dist/typings/*.d.cts",
        "default": "./dist/cjs/*.js"
      },
      "import": {
        "types": "./dist/typings/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "default": {
        "types": "./dist/typings/*.d.ts",
        "default": "./dist/esm/*.js"
      }
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@envelop/core": "workspace:^",
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "dependencies": {
    "@apollo/utils.keyvaluecache": "^3.1.0",
    "tslib": "^2.5.0",
    "@whatwg-node/promise-helpers": "^2.0.0"
  },
  "devDependencies": {
    "@apollo/datasource-rest": "6.4.1",
    "@envelop/core": "workspace:^",
    "@graphql-tools/schema": "11.0.0-alpha-20261015220015-2b402d9ad6308ef8eee2c46d885ed0b3f5cf05ff",
    "graphql": "17.0.2",
    "typescript": "6.0.2"
  },
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "sideEffects": false,
  "buildOptions": {
    "input": "./src/index.ts"
  },
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
